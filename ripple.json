                            "source": "https://github.com/XRPLF/rippled/blob/3.4.1/src/libxrpl/protocol/ErrorCodes.cpp"
                        },
                        {
                            "id": "xrp.txn_not_found",
                            "interface": "jsonrpc",
                            "regex": "^(?:txnNotFound)\\b",
                            "error": "CHAIN_TX_NOT_FOUND",
